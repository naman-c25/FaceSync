{
  "name": "facepay-backend",
  "version": "0.1.0",
  "license": "MIT",
  "description": "API and orchestration layer for the phone-less biometric payment system",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
