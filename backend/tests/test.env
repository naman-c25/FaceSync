# Throwaway configuration for the test suite. This key protects nothing — it
# exists so config validation passes and encryption round-trips can be checked.
# Never reuse it anywhere real.
NODE_ENV=test
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
ENCRYPTION_KEY_VERSION=1
MONGODB_URI=mongodb://127.0.0.1:27017/facepay_test
ML_SERVICE_URL=http://127.0.0.1:8099
ML_SERVICE_TIMEOUT_MS=3000
MAX_VERIFICATION_ATTEMPTS=3

# Lowered so candidate-pool narrowing can be exercised with a handful of users
# instead of the 500 the production default would need.
CANDIDATE_POOL_NARROW_ABOVE=2

# Off here only. Every test runs from one address, so limits meant for the
# open internet would have the suite refusing itself. rateLimit.test.js builds
# its own limiters with small numbers to check they actually refuse.
RATE_LIMIT_ENABLED=false
